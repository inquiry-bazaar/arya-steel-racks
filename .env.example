# ---- Database (MongoDB Atlas or local) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/arya?retryWrites=true&w=majority

# ---- Admin login (/admin/login) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Any random string, 16+ characters. Generate: openssl rand -base64 32
SESSION_SECRET=

# ---- Cloudflare R2 (blog cover images) ----
CLOUD_FLARE_ACCOUNT_ID=
CLOUD_FLARE_ACCESS_KEY_ID=
CLOUD_FLARE_SECRET_ACCESS_KEY=
CLOUD_FLARE_R2_BUCKET=
# Public bucket URL / custom domain, no trailing slash
CLOUD_FLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
